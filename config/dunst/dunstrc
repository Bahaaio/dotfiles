# documentation: https://dunst-project.org/documentation

[global]
    follow = mouse
    origin = top-right

    width = (300, 400)
    height = (0, 250)
    offset = (10, 10)
    notification_limit = 5

    padding = 12
    horizontal_padding = 12
    gap_size = 8
    frame_width = 2
    frame_color = "#343746b3"
    corner_radius = 16

    font = Inter 13
    markup = full
    show_indicators = false

    min_icon_size = 0
    max_icon_size = 50

    sticky_history = false
    history_length = 50

    mouse_left_click = do_action, close_current

[urgency_low]
    timeout = 4
    background = "#1b1b25e6"
    foreground = "#dedede"

[urgency_normal]
    timeout = 5
    background = "#1b1b25e6"
    foreground = "#dedede"

[urgency_critical]
    timeout = 0
    background = "#1b1b25e6"
    foreground = "#dedede"
    frame_color = "#f07178"
